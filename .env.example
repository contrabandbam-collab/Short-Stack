# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Client Configuration (Public / Browser Safe)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-api-key"

# Supabase Server Configuration (Strictly Server-Only Secrets)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
ADMIN_EMAILS="admin@shortstack.local,contrabandbam@gmail.com"
DATABASE_URL="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres"

# Square Payments API Configuration (Server-Side Secrets)
# Never commit real credentials to source code. Set these in AI Studio secrets.
SQUARE_ACCESS_TOKEN=""
SQUARE_APPLICATION_ID=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"
SQUARE_LIVE_PAYMENTS_ENABLED="false"
ENABLE_PAYMENT_SIMULATOR="false"
